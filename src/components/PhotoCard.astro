---
interface Props {
  title: string;
  cover?: string;
  location?: string;
  camera?: string;
  date?: Date;
  lens?: string;
  exposure?: string;
}

const { title, cover, location, camera, date, lens, exposure } = Astro.props;

const monthYear = date
  ? date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : undefined;
const fullDate = date
  ? date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : undefined;
---

<figure class="photo">
  <button
    type="button"
    class="photo-trigger"
    data-photo-trigger
    data-full={cover}
    data-title={title}
    data-location={location}
    data-camera={camera}
    data-date={fullDate}
    data-lens={lens}
    data-exposure={exposure}
    aria-label={`View ${title} larger`}
    disabled={!cover}
  >
    <div class="photo-cover">
      {
        cover ? (
          <img src={cover} alt={title} loading="lazy" />
        ) : (
          <div class="photo-placeholder" aria-hidden="true" />
        )
      }
    </div>
  </button>
  <figcaption>
    <p class="photo-title">{title}</p>
    {
      (location || monthYear || camera) && (
        <p class="photo-meta muted">
          {location}
          {location && (monthYear || camera) && <span> · </span>}
          {monthYear}
          {monthYear && camera && <span> · </span>}
          {camera}
        </p>
      )
    }
  </figcaption>
</figure>

<style>
  .photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .photo-trigger {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    cursor: zoom-in;
    border-radius: 4px;
    overflow: hidden;
    display: block;
  }

  .photo-trigger:disabled {
    cursor: default;
  }

  .photo-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .photo-cover {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 4px;
    background-color: var(--bg-secondary);
  }

  .photo-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .photo-trigger:hover:not(:disabled) .photo-cover img {
    transform: scale(1.03);
  }

  .photo-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(160deg, var(--bg-secondary), var(--accent-green));
    opacity: 0.6;
  }

  .photo-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    margin: 0;
  }

  .photo-meta {
    margin: 0;
  }
</style>
