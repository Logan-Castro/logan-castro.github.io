---
const year = new Date().getFullYear();
const email = 'loganacastro@gmail.com';
---

<footer class="footer">
  <div class="container footer-inner">
    <p class="footer-name">Logan Castro</p>
    <div class="footer-right">
      <ul class="footer-links">
        <li class="email-item">
          <button type="button" class="email-btn" data-copy-email aria-label={`Copy email address ${email}`}>
            {email}
          </button>
          <span class="email-toast" data-email-toast aria-live="polite"></span>
        </li>
        <li>
          <a href="https://www.linkedin.com/in/loganacastro" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </li>
      </ul>
      <p class="footer-meta muted">© {year}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    border-top: 1px solid var(--border);
    padding-block: 2.5rem;
    background-color: var(--bg-secondary);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-name {
    font-family: var(--font-serif);
    font-weight: 700;
    color: var(--text-primary);
  }

  .footer-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-links a,
  .email-btn {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-family: inherit;
  }

  .footer-links a:hover,
  .email-btn:hover {
    color: var(--accent);
  }

  .email-item {
    position: relative;
  }

  .email-btn {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s;
  }

  .email-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .email-toast {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 50%;
    transform: translate(-50%, 4px);
    background-color: var(--text-primary);
    color: var(--bg-primary);
    font-size: 0.75rem;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease-out, transform 0.18s ease-out;
  }

  .email-toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .email-toast {
      transition: opacity 0.05s;
      transform: translate(-50%, 0);
    }
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-copy-email]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.textContent?.trim();
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch {}
        document.body.removeChild(ta);
      }
      const toast = btn.parentElement?.querySelector('[data-email-toast]');
      if (toast) {
        toast.textContent = 'Copied!';
        toast.classList.add('is-visible');
        clearTimeout(toast._t);
        toast._t = setTimeout(() => toast.classList.remove('is-visible'), 1500);
      }
    });
  });
</script>
