---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import PhotoLightbox from '../../components/PhotoLightbox.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const imageDir = project.data.imageDir ?? project.id;

const statusLabel: Record<string, string> = {
  completed: 'Completed',
  'in-progress': 'In Progress',
  'on-horizon': 'On the Horizon',
};

const categoryLabel: Record<string, string> = {
  vehicles: 'Vehicles',
  fabrication: 'Fabrication',
  mechatronics: 'Mechatronics',
  class: 'Class Projects',
  dorm: 'Dorm Builds',
  fun: 'Fun',
};

interface ParsedSection {
  heading: string;
  images: string[];
  bodyHtml: string;
}

function renderMd(md: string): string {
  return marked.parse(md.trim(), { async: false }) as string;
}

function parseSections(body: string): { intro: string; sections: ParsedSection[] } {
  const lines = body.split(/\r?\n/);
  const introLines: string[] = [];
  const sections: ParsedSection[] = [];
  let current: { heading: string; images: string[]; bodyLines: string[] } | null = null;
  let seenContent = false;

  const flush = () => {
    if (!current) return;
    sections.push({
      heading: current.heading,
      images: current.images,
      bodyHtml: renderMd(current.bodyLines.join('\n')),
    });
    current = null;
  };

  for (const line of lines) {
    const h2 = line.match(/^##\s+(.+?)\s*$/);
    if (h2) {
      flush();
      current = { heading: h2[1], images: [], bodyLines: [] };
      seenContent = false;
      continue;
    }
    if (current) {
      if (!seenContent) {
        if (line.trim() === '') continue;
        const cm = line.match(/^\s*<!--\s*images:\s*(.+?)\s*-->\s*$/);
        if (cm) {
          current.images = cm[1].split(',').map((s) => s.trim()).filter(Boolean);
          continue;
        }
        seenContent = true;
      }
      current.bodyLines.push(line);
    } else {
      introLines.push(line);
    }
  }
  flush();

  return {
    intro: introLines.join('\n').trim() ? renderMd(introLines.join('\n')) : '',
    sections,
  };
}

const { intro, sections } = parseSections(project.body ?? '');

let imgIndex = 0;
const renderedSections = sections.map((s) => {
  if (s.images.length === 0) {
    return { ...s, imageSide: null as 'left' | 'right' | null };
  }
  const imageSide: 'left' | 'right' = imgIndex % 2 === 0 ? 'right' : 'left';
  imgIndex++;
  return { ...s, imageSide };
});
---

<Base title={`${project.data.title} — Logan Castro`} description={project.data.description}>
  <article>
    <header class="project-head">
      <div class="container head-grid">
        <div class="head-meta">
          <h1>{project.data.title}</h1>
          <p class="context muted">{project.data.context}</p>
          {
            project.data.team && project.data.team.length > 0 && (
              <p class="team muted">
                <strong>Team:</strong>{' '}
                {project.data.team.map((member, i) => (
                  <span>
                    {member}
                    {i < project.data.team!.length - 1 && <span class="sep"> · </span>}
                  </span>
                ))}
              </p>
            )
          }
          {
            project.data.tags.length > 0 && (
              <ul class="tags">
                {project.data.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="head-cover">
          {
            project.data.cover ? (
              <img
                src={project.data.cover}
                alt={project.data.coverAlt ?? project.data.title}
                loading="eager"
              />
            ) : (
              <div class="cover-placeholder" aria-hidden="true">
                <span>{project.data.title.charAt(0)}</span>
              </div>
            )
          }
        </div>
      </div>
    </header>

    <div class="container project-body">
      {intro && <div class="intro-block" set:html={intro} />}
      {
        renderedSections.map((s) =>
          s.images.length > 0 ? (
            <section class="process-section" data-image-side={s.imageSide}>
              <div class="process-text">
                <h2>{s.heading}</h2>
                <div set:html={s.bodyHtml} />
              </div>
              <div class={`process-images count-${s.images.length}`}>
                {s.images.map((file) => {
                  const src = `/images/projects/${imageDir}/${file}`;
                  return (
                    <button
                      type="button"
                      class="process-image"
                      data-photo-trigger
                      data-full={src}
                      data-title={s.heading}
                      aria-label={`View ${s.heading} image larger`}
                    >
                      <img src={src} alt={s.heading} loading="lazy" />
                    </button>
                  );
                })}
              </div>
            </section>
          ) : (
            <section class="text-section">
              <h2>{s.heading}</h2>
              <div set:html={s.bodyHtml} />
            </section>
          )
        )
      }
    </div>

    <footer class="project-foot">
      <div class="container">
        <a href="/projects" class="back-link">← Back to all projects</a>
      </div>
    </footer>
  </article>

  <PhotoLightbox />
</Base>

<style>
  .project-head {
    padding-block: 4rem;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border);
  }

  .head-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .head-meta h1 {
    margin: 0 0 1rem;
  }

  .eyebrow {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }

  .sep {
    opacity: 0.5;
  }

  .context {
    margin: 0 0 0.5rem;
  }

  .team {
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
  }

  .team strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
  }

  .tags li {
    font-size: 0.8rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    color: var(--text-muted);
  }

  .head-cover {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background-color: var(--bg-primary);
    border: 1px solid var(--border);
    align-self: center;
  }

  .head-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--accent-green) 0%, var(--accent) 100%);
    opacity: 0.5;
  }

  .cover-placeholder span {
    font-family: var(--font-serif);
    font-size: 4rem;
    font-weight: 700;
    color: var(--bg-primary);
  }

  .project-body {
    max-width: 1100px;
    padding-block: 3.5rem;
  }

  .intro-block,
  .text-section {
    max-width: 720px;
  }

  .text-section {
    margin: 3rem auto;
  }

  .project-body :global(h2) {
    font-size: 1.5rem;
    margin-top: 0;
    margin-bottom: 1rem;
  }

  .project-body :global(h3) {
    font-size: 1.15rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .project-body :global(p) {
    margin: 0 0 1.25rem;
    color: var(--text-primary);
    line-height: 1.7;
  }

  .project-body :global(p:last-child) {
    margin-bottom: 0;
  }

  .project-body :global(ul),
  .project-body :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
    padding-left: 0;
  }

  .project-body :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .process-section {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3rem;
    align-items: center;
    margin-block: 4rem;
  }

  .process-section[data-image-side='left'] .process-text {
    order: 2;
  }

  .process-section[data-image-side='left'] .process-images {
    order: 1;
  }

  .process-images {
    display: grid;
    gap: 0.75rem;
    height: 420px;
  }

  .process-images.count-1 {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
  }

  .process-images.count-2 {
    grid-template-columns: 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .process-images.count-3 {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }

  .process-images.count-3 > :nth-child(2) {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    height: calc(50% - 0.375rem);
  }

  .process-images.count-3 > :nth-child(3) {
    grid-column: 1;
    grid-row: 2;
  }

  .process-image {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    border-radius: 6px;
    overflow: hidden;
    display: block;
  }

  .process-image:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .process-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .process-image:hover img {
    transform: scale(1.03);
  }

  .project-foot {
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--border);
  }

  .back-link {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  @media (max-width: 800px) {
    .head-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .process-section {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-block: 2.5rem;
    }

    .process-section[data-image-side='left'] .process-text,
    .process-section[data-image-side='left'] .process-images {
      order: unset;
    }

    .process-images {
      height: 320px;
    }
  }
</style>
